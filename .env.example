# ==============================================================================
# BACKEND ENVIRONMENT CONFIGURATION
# ==============================================================================

PORT=3000
NODE_ENV=development

# PostgreSQL 16 Connection
DATABASE_URL=postgres://postgres:postgres@localhost:5432/chatbot_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=chatbot_db

# Administrador inicial (solo se usa la primera vez, con la base vacía)
# Si dejás ADMIN_PASSWORD en blanco, el sistema genera una contraseña aleatoria
# y la muestra UNA sola vez en la consola al arrancar.
ADMIN_EMAIL=admin@empresa.com
ADMIN_PASSWORD=

# Security & Cryptography (AES-256-GCM 32-byte hex key = 64 characters)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# Orígenes autorizados para el navegador (CORS y WebSocket), separados por comas.
# En producción poné tu dominio real, por ejemplo: https://lecturasdetarde.online
# Si lo dejás vacío en producción, solo se acepta el mismo origen.
ALLOWED_ORIGINS=

SESSION_SECRET=super_secret_jwt_and_cookie_key_change_in_production_987654321

# Meta Platform Graph API v26.0
META_APP_ID=tu_app_id_de_meta_developers
META_APP_SECRET=tu_app_secret_de_meta_developers
# ID de la configuración de "Inicio de sesión con Facebook para empresas".
# Se crea en el panel de Meta: tu app -> Inicio de sesión con Facebook para
# empresas -> Configuraciones -> Crear configuración.
META_LOGIN_CONFIG_ID=

META_VERIFY_TOKEN=token_seguro_para_handshake_de_webhook
META_API_VERSION=v26.0

# ==============================================================================
# Almacenamiento de archivos (Cloudinary) — opcional pero muy recomendado
# ------------------------------------------------------------------------------
# El disco del servidor se borra en cada despliegue, así que sin esto las fotos,
# audios y documentos del chat dejan de verse. Con esto configurado, los archivos
# se guardan en Cloudinary y sobreviven.
#
# Los datos están en el panel de Cloudinary, en "Product Environment Credentials".
# ==============================================================================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=bandeja-unificada

# ==============================================================================
# API de Conversiones (informar ventas a Meta) — opcional
# ------------------------------------------------------------------------------
# Permite avisarle a Meta que una conversación terminó en venta, para que los
# anuncios se optimicen con resultados reales y no con clics.
#
# META_DATASET_ID: el identificador del conjunto de datos (antes "píxel"), que
#   está en el Administrador de eventos de tu Business Manager.
# META_CONVERSIONS_TOKEN: conviene generarlo como token de un usuario del
#   sistema en el Business Manager. Al estar la BM verificada no necesita pasar
#   por la revisión de la app y no caduca.
# META_TEST_EVENT_CODE: mientras probás, poné acá el código de "Eventos de
#   prueba" del Administrador de eventos. Los eventos aparecen ahí sin ensuciar
#   los datos reales. Dejalo vacío cuando salgas a producción.
# ==============================================================================
META_DATASET_ID=
META_CONVERSIONS_TOKEN=
META_TEST_EVENT_CODE=

# Si cada canal informa a un conjunto de datos distinto (lo habitual: el de
# WhatsApp es el que Meta ata a la cuenta de WhatsApp Business, y Messenger e
# Instagram usan un píxel del negocio), definilos acá. Lo que se ponga en estas
# variables manda sobre las generales de arriba. Si además cada negocio está en
# un Business Manager distinto, también cambia el token.
META_DATASET_ID_WHATSAPP=
META_CONVERSIONS_TOKEN_WHATSAPP=
META_DATASET_ID_MESSENGER=
META_CONVERSIONS_TOKEN_MESSENGER=
META_DATASET_ID_INSTAGRAM=
META_CONVERSIONS_TOKEN_INSTAGRAM=
