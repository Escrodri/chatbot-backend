# ==============================================================================
# BACKEND ENVIRONMENT CONFIGURATION
# ==============================================================================

PORT=3000
NODE_ENV=development

# PostgreSQL 16 Connection
DATABASE_URL=postgres://postgres:postgres@localhost:5432/chatbot_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=chatbot_db

# Administrador inicial (solo se usa la primera vez, con la base vacía)
# Si dejás ADMIN_PASSWORD en blanco, el sistema genera una contraseña aleatoria
# y la muestra UNA sola vez en la consola al arrancar.
ADMIN_EMAIL=admin@empresa.com
ADMIN_PASSWORD=

# Security & Cryptography (AES-256-GCM 32-byte hex key = 64 characters)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# Orígenes autorizados para el navegador (CORS y WebSocket), separados por comas.
# En producción poné tu dominio real, por ejemplo: https://lecturasdetarde.online
# Si lo dejás vacío en producción, solo se acepta el mismo origen.
ALLOWED_ORIGINS=

SESSION_SECRET=super_secret_jwt_and_cookie_key_change_in_production_987654321

# ==============================================================================
# CONFIGURACIÓN DE META (100% OPCIONAL)
# ------------------------------------------------------------------------------
# ¡IMPORTANTE! NO necesitas definir ninguna de estas variables en tu archivo .env.
# Todos los canales (WhatsApp, Messenger, Instagram) y la API de Conversiones
# se conectan y configuran MANUALMENTE desde la interfaz web (Ajustes > Canales).
# Las variables aquí abajo solo sirven como fallbacks globales si decides usarlas.
# ==============================================================================
# META_APP_ID=
# META_APP_SECRET=
# META_VERIFY_TOKEN=meta_webhook_verify_token_secure_2026
# META_API_VERSION=v21.0

# ==============================================================================
# Almacenamiento de archivos (Cloudinary) — opcional pero muy recomendado
# ------------------------------------------------------------------------------
# El disco del servidor se borra en cada despliegue, así que sin esto las fotos,
# audios y documentos del chat dejan de verse. Con esto configurado, los archivos
# se guardan en Cloudinary y sobreviven.
#
# Los datos están en el panel de Cloudinary, en "Product Environment Credentials".
# ==============================================================================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=bandeja-unificada

# ==============================================================================
# API de Conversiones (informar ventas a Meta) — 100% opcional
# ------------------------------------------------------------------------------
# También se configura manualmente en cada canal desde la web (Ajustes > Canales > Editar).
# Solo completa estas variables si prefieres un conjunto de datos global por defecto.
# ==============================================================================
# META_DATASET_ID=
# META_CONVERSIONS_TOKEN=
# META_TEST_EVENT_CODE=


# ==============================================================================
# Automatización con n8n — opcional
# ------------------------------------------------------------------------------
# Con AUTOMATION_ENABLED=true, cada mensaje entrante de cliente se reenvía a
# N8N_WEBHOOK_URL y el bot de bienvenida interno queda callado (para que los dos
# no contesten encima). n8n responde llamando de vuelta a
# POST /api/conversations/:id/messages con la cabecera x-service-token.
#
# N8N_SERVICE_TOKEN es una clave compartida que generás vos. Cualquier cadena
# larga y aleatoria sirve; tiene que ser IDÉNTICA acá y en n8n.
#   Para generarla:  openssl rand -hex 32
#
# Si n8n corre en el mismo servidor (EasyPanel), usá la URL interna del servicio:
# no hace falta exponer nada a internet.
# ==============================================================================
AUTOMATION_ENABLED=false
N8N_WEBHOOK_URL=
N8N_SERVICE_TOKEN=
N8N_TIMEOUT_MS=8000

# ==============================================================================
# Dirección pública de este backend.
# ------------------------------------------------------------------------------
# Meta la usa para descargar las imágenes y audios que le mandás. Si no se
# define, el código cae a una URL vieja hardcodeada: definila siempre en
# producción o los archivos van a apuntar a un servidor que ya no existe.
# ==============================================================================
BACKEND_PUBLIC_URL=

# ==============================================================================
# TLS contra PostgreSQL.
# ------------------------------------------------------------------------------
# Las bases administradas (Render, Neon, Supabase) exigen SSL. Un Postgres en
# Docker en el mismo servidor NO lo tiene habilitado: ahí va false, o cada
# consulta falla con "The server does not support SSL connections".
# Vacío = se decide solo mirando el host de DATABASE_URL.
# ==============================================================================
DATABASE_SSL=

# ==============================================================================
# Recuperación de abandonos.
# ------------------------------------------------------------------------------
# Volver a escribirle al que miró el precio y se fue. Tres escalones contados
# desde su último movimiento: a los 120 minutos un recordatorio al precio de
# siempre, a los 480 y a los 1200 el precio de recuperación del producto (se
# carga en Productos; vacío = se insiste al precio de lista). No hay un cuarto.
#
# El silencio es horario de Paraguay y no se toca: un recordatorio a las tres
# de la mañana no cancela una venta, convierte el número en un reporte. Lo que
# cae en esa franja espera a la hora de apertura, y si para entonces ya se
# venció la ventana gratuita de 24h de Meta, se descarta en vez de pagar una
# plantilla.
#
# RECUPERACION_ACTIVA=false apaga todo el ciclo.
# ==============================================================================
RECUPERACION_ACTIVA=true
RECUPERACION_CADA_MIN=15
RECUPERACION_PASO_1=120
RECUPERACION_PASO_2=480
RECUPERACION_PASO_3=1200
RECUPERACION_SILENCIO_DESDE=21
RECUPERACION_SILENCIO_HASTA=8
RECUPERACION_MAX_POR_PASADA=40

# ==============================================================================
# Cuenta que recibe las transferencias.
# ------------------------------------------------------------------------------
# PAGO_CUENTA, PAGO_ALIAS y PAGO_DOCUMENTO son los tres identificadores con los
# que te puede llegar la plata. La entrega automática acepta el comprobante si
# la cuenta de destino coincide con CUALQUIERA de los tres: quien transfiere
# por alias ve el alias en su comprobante, no el número de cuenta, y comparar
# solo contra PAGO_CUENTA rechazaba transferencias buenas.
#
# PAGO_TITULAR es el control que ataja lo que las cifras no pueden: una
# transferencia real a una cuenta ajena que termina igual por casualidad. Si el
# comprobante muestra el titular y no comparte el apellido, va a revisión.
#
# Sin ninguno de los tres cargados, la entrega automática no aprueba nada.
# ==============================================================================
PAGO_CUENTA=
PAGO_ALIAS=
PAGO_DOCUMENTO=
PAGO_TITULAR=
PAGO_BANCO=

# Tope de entregas automáticas por día (0 = sin tope).
# Es la red que atrapa lo que ningún control individual ve: que TODOS los
# comprobantes estén pasando. Llegado al tope no se rechaza nada, pasa a
# revisión humana.
ENTREGA_AUTO_MAX_DIA=15
