# ==============================================================================
# BACKEND ENVIRONMENT CONFIGURATION
# ==============================================================================

PORT=3000
NODE_ENV=development

# PostgreSQL 16 Connection
DATABASE_URL=postgres://postgres:postgres@localhost:5432/chatbot_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=chatbot_db

# SSL para PostgreSQL:
# false = En Docker / EasyPanel interno (evita "The server does not support SSL connections").
# true  = En bases administradas en la nube con SSL obligatorio (Render, Railway, Supabase, Neon).
DATABASE_SSL=false

# Dominio público del backend (imprescindible en producción):
# Es la URL pública donde está publicado este backend (ej: https://api.tudominio.com).
# Meta la utiliza para descargar notas de voz, fotos y archivos adjuntos locales enviados desde el chat.
BACKEND_PUBLIC_URL=

# Administrador inicial (solo se usa la primera vez, con la base vacía)
# Si dejás ADMIN_PASSWORD en blanco, el sistema genera una contraseña aleatoria
# y la muestra UNA sola vez en la consola al arrancar.
ADMIN_EMAIL=admin@empresa.com
ADMIN_PASSWORD=

# Security & Cryptography (AES-256-GCM 32-byte hex key = 64 characters)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# Orígenes autorizados para el navegador (CORS y WebSocket), separados por comas.
# En producción poné tu dominio real, por ejemplo: https://lecturasdetarde.online
# Si lo dejás vacío en producción, solo se acepta el mismo origen.
ALLOWED_ORIGINS=

SESSION_SECRET=super_secret_jwt_and_cookie_key_change_in_production_987654321

# ==============================================================================
# CONFIGURACIÓN DE META (100% OPCIONAL)
# ------------------------------------------------------------------------------
# ¡IMPORTANTE! NO necesitas definir ninguna de estas variables en tu archivo .env.
# Todos los canales (WhatsApp, Messenger, Instagram) y la API de Conversiones
# se conectan y configuran MANUALMENTE desde la interfaz web (Ajustes > Canales).
# Las variables aquí abajo solo sirven como fallbacks globales si decides usarlas.
# ==============================================================================
# META_APP_ID=
# META_APP_SECRET=
# META_VERIFY_TOKEN=meta_webhook_verify_token_secure_2026
# META_API_VERSION=v26.0

# ==============================================================================
# Almacenamiento de archivos (Cloudinary) — opcional pero muy recomendado
# ------------------------------------------------------------------------------
# El disco del servidor se borra en cada despliegue, así que sin esto las fotos,
# audios y documentos del chat dejan de verse. Con esto configurado, los archivos
# se guardan en Cloudinary y sobreviven.
#
# Los datos están en el panel de Cloudinary, en "Product Environment Credentials".
# ==============================================================================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=bandeja-unificada

# ==============================================================================
# API de Conversiones (informar ventas a Meta) — 100% opcional
# ------------------------------------------------------------------------------
# También se configura manualmente en cada canal desde la web (Ajustes > Canales > Editar).
# Solo completa estas variables si prefieres un conjunto de datos global por defecto.
# ==============================================================================
# META_DATASET_ID=
# META_CONVERSIONS_TOKEN=
# META_TEST_EVENT_CODE=

